# Copy this file to .env and fill in the values. Never commit .env!

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: your test server's ID. When set, `npm run deploy` registers commands
# to just that server so they show up instantly. Leave empty to register globally.
# (Enable Developer Mode in Discord, then right-click your server -> Copy Server ID.)
DISCORD_GUILD_ID=
